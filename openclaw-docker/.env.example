# Copy to .env and fill in:   cp .env.example .env
# Never commit .env to git.

# --- AI model (free tier from aistudio.google.com) ---
GEMINI_API_KEY=

# --- OpenClaw dashboard login token ---
# Generate with:   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=idx_user
MYSQL_PASSWORD=change-me-agent
MYSQL_DATABASE=idx_exchange
# (MYSQL_HOST is set to "mysql" inside docker-compose.yml — don't use localhost)

# --- Email (Week 11) — Gmail app password, ideally on a throwaway Gmail ---
EMAIL_USER=
EMAIL_PASSWORD=
